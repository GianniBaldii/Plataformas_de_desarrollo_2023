
@model List<AnirokWeb.Models.Producto>
<main>
    <section class="section-heading" aria-labelledby="titulo-categoria">
        <span class="section-heading__eyebrow">Explorá el catálogo</span>
        <h1 id="titulo-categoria">@ViewBag.Categoria</h1>
        <p>Consultá precio, disponibilidad y detalle antes de agregar al carrito.</p>
    </section>

    <section class="mb-4">
        <!-- Filas con tarjetas -->
        <div class="row">
            @if (Model == null || !Model.Any())
            {
                <p>No hay productos disponibles en esta categoría.</p>
            }
            else
            {
                foreach (var producto in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-3 mb-4">
                        @Html.Partial("_ProductoCard", producto)
                    </div>
                }
            }
        </div>
    </section>
</main>
