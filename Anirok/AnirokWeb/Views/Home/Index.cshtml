@model List<AnirokWeb.Models.Producto>

@{
    ViewBag.Title = "Home Page";
}


@if (TempData["LoginSuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["LoginSuccessMessage"]
    </div>
}



<main>
    <!-- Carrusel (Carousel) para pantallas grandes -->
    <div id="carouselExample" class="carousel slide d-none d-md-block" data-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">

                <img src="~/Content/Images/slide4.jpg" class="d-block w-100" alt="GIF">
            </div>
            <div class="carousel-item">
                <!-- Puedes agregar más elementos con GIFs -->
                <img src="~/Content/Images/slide5.jpg" class="d-block w-100" alt="Otro GIF">
            </div>
            <!-- Agrega más elementos según sea necesario -->
        </div>
        <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

    <section class="row" aria-labelledby="aspnetTitle">
        <h1 class="mt-4">RECOMENDADOS</h1>

    </section>


    <section class="mb-4">
        <!-- Filas con tarjetas -->
        <section class="mb-4">
            <!-- Filas con tarjetas -->
            <div class="row">
                @if (Model == null || !Model.Any())
                {
                    <p>No hay productos disponibles en esta categoría.</p>
                }
                else
                {
                    foreach (var producto in Model)
                    {
                        <div class="col-md-3 mb-3">
                            <div class="card h-100">
                                <div class="ratio ratio-1x1">
                                    <img src="@Url.Content("~/Content/Images/" + producto.Img)" class="card-img-top" alt="@producto.Nombre">
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@producto.Nombre</h5>
                                    <p class="card-text">@producto.Descripcion</p>
                                    <div class="mt-auto d-flex justify-content-between">
                                        <form method="post" action="@Url.Action("AgregarAlCarrito", "Carrito")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productoId" value="@producto.Id" />
                                            <button type="submit" class="btn btn-secondary"><i class="fa-solid fa-cart-plus fa-xl"></i></button>
                                        </form>
                                        <a href="@Url.Action("Ver", "Producto", new { id = producto.Id })" class="btn btn-secondary bg-black"><i class="fa-solid fa-eye fa-xl"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- Filas con tarjetas -->
        <div class="row">
            <!-- Segunda fila -->
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <div class="ratio ratio-1x1">
                        <img src="~/Content/Images/34.jpg" class="card-img-top" alt="Collar Chainsaw Man Pochita">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Collar Chainsaw Man Pochita</h5>
                        <p class="card-text">Collar de acero inoxidable hipoalergenico, pintado. Industria Argentina.</p>
                        <div class="mt-auto d-flex justify-content-between">
                            <a href="#" class="btn btn-secondary"><i class="fa-solid fa-cart-plus fa-xl"></i></a>
                            <a href="#" class="btn btn-secondary bg-black"><i class="fa-solid fa-eye fa-xl"></i></a>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3  mb-3">
                <div class="card h-100">
                    <div class="ratio ratio-1x1">
                        <img src="~/Content/Images/35.jpg" class="card-img-top" alt="Bufanda Ravenclaw Harry Potter">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Bufanda Ravenclaw Harry Potter</h5>
                        <p class="card-text">Bufanda Ravenclaw importada con bordado de la escuela. Color azul y gris.</p>
                        <div class="mt-auto d-flex justify-content-between">
                            <a href="#" class="btn btn-secondary"><i class="fa-solid fa-cart-plus fa-xl"></i></a>
                            <a href="#" class="btn btn-secondary bg-black"><i class="fa-solid fa-eye fa-xl"></i></a>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3  mb-3">
                <div class="card h-100">
                    <div class="ratio ratio-1x1">
                        <img src="~/Content/Images/36.jpg" class="card-img-top" alt="Cartuchera Dragon Ball Z Goku Mini">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Cartuchera Dragon Ball Z Goku Mini</h5>
                        <p class="card-text">Cartuchera ecologica Dragon Ball Z, rígida.</p>
                        <div class="mt-auto d-flex justify-content-between">
                            <a href="#" class="btn btn-secondary"><i class="fa-solid fa-cart-plus fa-xl"></i></a>
                            <a href="#" class="btn btn-secondary bg-black"><i class="fa-solid fa-eye fa-xl"></i></a>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <div class="ratio ratio-1x1">
                        <img src="~/Content/Images/37.jpg" class="card-img-top" alt="Llavero Totoro Metal">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Llavero Totoro Metal</h5>
                        <p class="card-text">Producto Importado. Llavero esmaltado, figura Totoro.</p>
                        <div class="mt-auto d-flex justify-content-between">
                            <a href="#" class="btn btn-secondary"><i class="fa-solid fa-cart-plus fa-xl"></i></a>
                            <a href="#" class="btn btn-secondary bg-black"><i class="fa-solid fa-eye fa-xl"></i></a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </section>



    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Popper.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

</main>
