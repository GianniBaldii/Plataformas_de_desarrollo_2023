@model AnirokWeb.Models.Producto

@using System.Globalization
@{
    ViewBag.Title = ViewBag.Title ?? "Detalle del producto";
    var cultura = CultureInfo.GetCultureInfo("es-AR");
}

<main class="product-detail">
    <nav class="product-breadcrumb" aria-label="Navegación">
        <a href="@Url.Action("Index", "Home")">Inicio</a>
        <span>/</span>
        <span>@(Model.Categoria == null ? "Productos" : Model.Categoria.Nombre)</span>
    </nav>

    <section class="product-detail__panel" aria-labelledby="producto-titulo">
        <div class="product-detail__media">
            <img src="@Url.Action("Imagen", "Producto", new { nombre = Model.Img })" alt="@Model.Nombre" />
        </div>

        <div class="product-detail__content">
            <span class="product-category">@(Model.Categoria == null ? "Producto" : Model.Categoria.Nombre)</span>
            <h1 id="producto-titulo">@Model.Nombre</h1>
            <p class="product-detail__price">@Model.Precio.ToString("C0", cultura)</p>
            <p class="product-detail__description">@Model.Descripcion</p>

            <dl class="product-facts">
                <div><dt>Código</dt><dd>@(string.IsNullOrWhiteSpace(Model.Codigo) ? "Sin especificar" : Model.Codigo)</dd></div>
                <div><dt>Proveedor</dt><dd>@(string.IsNullOrWhiteSpace(Model.Proveedor) ? "Sin especificar" : Model.Proveedor)</dd></div>
                <div><dt>Talle</dt><dd>@(string.IsNullOrWhiteSpace(Model.Talle) ? "No aplica" : Model.Talle)</dd></div>
                <div><dt>Disponibilidad</dt><dd>@(Model.Stock > 0 ? Model.Stock + " unidades" : "Sin stock")</dd></div>
            </dl>

            <form method="post" action="@Url.Action("AgregarAlCarrito", "Carrito")" class="product-detail__purchase">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productoId" value="@Model.Id" />
                <div class="quantity-field">
                    <label for="cantidad">Cantidad</label>
                    <input type="number" id="cantidad" name="cantidad" inputmode="numeric" min="1" max="@Math.Max(Model.Stock, 1)" value="1" @(Model.Stock <= 0 ? "disabled" : "") />
                </div>
                <button type="submit" class="product-detail__button" @(Model.Stock <= 0 ? "disabled" : "")>
                    <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
                    @(Model.Stock > 0 ? "Agregar al carrito" : "Producto sin stock")
                </button>
            </form>
        </div>
    </section>
</main>


