@using System.Globalization
@model AnirokWeb.Models.Producto

<article class="card product-card h-100">
    <a class="product-card__media" href="@Url.Action("Ver", "Producto", new { id = Model.Id })">
        <img src="@Url.Action("Imagen", "Producto", new { nombre = Model.Img })" alt="@Model.Nombre" loading="lazy" />
    </a>
    <div class="card-body product-card__body">
        <div class="product-card__meta">
            <span class="product-category">@(Model.Categoria == null ? "Producto" : Model.Categoria.Nombre)</span>
            @if (Model.Stock > 0)
            {
                <span class="stock-badge stock-badge--available">@Model.Stock disponibles</span>
            }
            else
            {
                <span class="stock-badge stock-badge--empty">Sin stock</span>
            }
        </div>
        <h2 class="product-card__title">@Model.Nombre</h2>
        <p class="product-card__description">@Model.Descripcion</p>
        <p class="product-card__price">@Model.Precio.ToString("C0", CultureInfo.GetCultureInfo("es-AR"))</p>
        <div class="product-actions">
            <form method="post" action="@Url.Action("AgregarAlCarrito", "Carrito")" class="product-actions__form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productoId" value="@Model.Id" />
                <button type="submit" class="product-action product-action--cart" @(Model.Stock <= 0 ? "disabled" : "")>
                    <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
                    <span>Agregar</span>
                </button>
            </form>
            <a href="@Url.Action("Ver", "Producto", new { id = Model.Id })" class="product-action product-action--detail">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                <span>Ver</span>
            </a>
        </div>
    </div>
</article>
