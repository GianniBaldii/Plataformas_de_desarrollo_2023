@model IEnumerable<AnirokWeb.Models.Categoria>

@foreach (var categoria in Model)
{
    <a class="tw-whitespace-nowrap tw-rounded-lg tw-px-3 tw-py-2 tw-text-sm tw-font-bold tw-text-white" href="@Url.Action("Categoria", "Producto", new { nombreCategoria = categoria.Nombre })">@categoria.Nombre</a>
}
