<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Agrega el enlace al icono Favicon -->
    <link rel="icon" href="../favicon.ico" type="image/x-icon">

    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="@Url.Content("~/Content/CSS/style.css?v=20261103-footer-images2")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/CSS/tailwind.css?v=20261030-1")" />
    @Scripts.Render("~/bundles/modernizr")
    <!--  CDN de Font Awesome -->
    <script src="https://kit.fontawesome.com/5ecef25f55.js" crossorigin="anonymous"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@900&family=Roboto:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
</head>
<body>
    <header class="tw-bg-[#b80000] tw-text-white tw-shadow-md">
    <nav class="tw-bg-[#b80000] tw-text-white">
        <div class="tw-mx-auto tw-flex tw-max-w-7xl tw-flex-wrap tw-items-center tw-gap-4 tw-px-4 tw-py-3 lg:tw-flex-nowrap">
            <div class="navbar-left tw-order-3 tw-flex tw-w-full tw-flex-1 tw-items-center lg:tw-order-2">
                <form class="form-inline d-flex" method="get" action="@Url.Action("Buscar", "Producto")">
                    <input class="tw-w-full tw-rounded-l-xl tw-border-0 tw-px-4 tw-py-3 tw-text-gray-900" name="buscar" type="search" placeholder="Buscar productos..." aria-label="Buscar">
                    <button class="tw-rounded-r-xl tw-bg-black tw-px-5 tw-py-3" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
            </div>
            <a class="tw-order-1 tw-shrink-0" href="@Url.Action("Index", "Home")"><img src="@Url.Content("~/Content/Images/logo_anirok.png")" alt="Anirok" class="tw-h-14 tw-w-auto tw-rounded-lg tw-bg-white tw-p-1" /></a>
            <div class="navbar-right tw-order-2 tw-ml-auto">
                <ul class="navbar-nav tw-flex tw-items-center tw-gap-2">
                    <li class="nav-item"><a class="cart-nav-link tw-relative tw-flex tw-h-11 tw-w-11 tw-items-center tw-justify-center tw-rounded-full tw-bg-black" href="@Url.Action("Index", "Carrito")"><i class="fa-solid fa-cart-shopping"></i><span class="cart-count" aria-label="Cantidad en carrito">@System.Linq.Enumerable.Sum((Session["Carrito"] as System.Collections.Generic.List<AnirokWeb.Models.CarritoItem>) ?? new System.Collections.Generic.List<AnirokWeb.Models.CarritoItem>(), x => x.Cantidad)</span></a></li>
                    <li class="nav-item">
                        @if (Session["UsuarioId"] != null)
                        {
                            <span class="tw-hidden tw-rounded-full tw-bg-white/15 tw-px-3 tw-py-2 tw-text-sm tw-font-bold sm:tw-inline-block">Hola, @Session["UsuarioNombre"]</span>
                            if (AnirokWeb.Services.RolesWeb.EsCliente(Session["UsuarioRol"]))
                            {
                                <a href="@Url.Action("Compras", "Cuenta")" class="tw-hidden tw-rounded-full tw-bg-white/15 tw-px-3 tw-py-2 text-white tw-text-sm tw-font-bold md:tw-inline-block">Mis compras</a>
                            }
                            <form method="post" action="@Url.Action("Logout", "Cuenta")" class="tw-m-0">@Html.AntiForgeryToken()<button type="submit" class="tw-flex tw-h-11 tw-items-center tw-gap-2 tw-rounded-full tw-bg-black tw-px-4 tw-font-bold"><i class="fa-solid fa-arrow-right-from-bracket"></i><span class="tw-hidden md:tw-inline">Salir</span></button></form>
                        }
                        else { <a href="@Url.Action("Login", "Cuenta")" class="tw-flex tw-h-11 tw-items-center tw-gap-2 tw-rounded-full tw-bg-black tw-px-4 tw-font-bold"><i class="fa-solid fa-user"></i><span class="tw-hidden md:tw-inline">Ingresar</span></a> }
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <nav class="tw-bg-black" aria-label="Categorías"><div class="tw-mx-auto tw-flex tw-max-w-7xl tw-items-center tw-gap-1 tw-overflow-x-auto tw-px-4 tw-py-2">@Html.Action("Categorias", "Producto")<a class="tw-whitespace-nowrap tw-rounded-lg tw-px-3 tw-py-2 tw-text-sm tw-font-bold tw-text-white" href="@Url.Action("Contact", "Home")">Contacto</a></div></nav>
    </header>


    <div class="container body-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="anirok-flash anirok-flash-success mt-3" role="status"><i class="fa-solid fa-circle-check mr-2"></i>@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="anirok-flash anirok-flash-error mt-3" role="alert"><i class="fa-solid fa-circle-exclamation mr-2"></i>@TempData["ErrorMessage"]</div>
        }
        @RenderBody()
     </div>
  <div class="footer-dark">
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-sm-6 col-md-3 item">
                    <h3>Contactanos</h3>
                    <ul>
                        <li><p><i class="m-2 fa-solid fa-phone"></i>47715792</p></li>
                        <li><p><i class="m-2 fa-solid fa-envelope"></i>anirok-atencion@anirok.com</p></li>
<li> <p><i class="m-2 fa-solid fa-location-dot"></i>Av. Corrientes 1234</p>
                    </ul>
                </div>
                <div class="col-sm-6 col-md-3 item">
                    <h3>Metodos de Pago</h3>
                    <ul>
                        <li> <i class="mr-2 fa-brands fa-cc-visa"></i></li>
                        <li>   <i class="mr-2 fa-brands fa-cc-mastercard"></i></li>
                        <li><i class="mr-2 fa-brands fa-cc-paypal"></i></li>
                    </ul>
                </div>
                <div class="col-md-6 item text">
                    <h3>Sobre Nosotros</h3>
                    <p>Praesent sed lobortis mi. Suspendisse vel placerat ligula. Vivamus ac sem lacus. Ut vehicula rhoncus elementum. Etiam quis tristique lectus. Aliquam in arcu eget velit pulvinar dictum vel in justo.</p>
                </div>
                <div class="col item social"><a href="#"><i class="fa-brands fa-instagram"></i></a><a href="#"><i class="fa-brands fa-facebook"></i></a><a href="#"><i class="fa-regular fa-envelope"></i></a></div>
            </div>
           
        </div>
    </footer>
</div>

   

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        (function () {
            function showCartNotice(message, ok) {
                var notice = document.querySelector('.cart-ajax-notice');
                if (!notice) { notice = document.createElement('div'); notice.className = 'cart-ajax-notice'; document.body.appendChild(notice); }
                notice.className = 'cart-ajax-notice ' + (ok ? 'is-success' : 'is-error');
                notice.innerHTML = '<i class="fa-solid ' + (ok ? 'fa-circle-check' : 'fa-circle-exclamation') + '"></i><span>' + message + '</span>' + (ok ? '<a href="/Carrito">Ver carrito</a>' : '');
                window.clearTimeout(notice._timer); notice._timer = window.setTimeout(function () { notice.classList.remove('is-visible'); }, 4500); notice.classList.add('is-visible');
            }
            document.addEventListener('submit', function (event) {
                var form = event.target.closest('.js-cart-form');
                if (!form) return;
                event.preventDefault();
                var button = form.querySelector('button[type="submit"]');
                var original = button.innerHTML;
                button.disabled = true; button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Agregando</span>';
                fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) { return response.json(); })
                    .then(function (data) { if (data.ok) { var count = document.querySelector('.cart-count'); if (count) count.textContent = data.count; } showCartNotice(data.message, data.ok); })
                    .catch(function () { showCartNotice('No se pudo agregar el producto. Intentá nuevamente.', false); })
                    .finally(function () { button.disabled = false; button.innerHTML = original; });
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
