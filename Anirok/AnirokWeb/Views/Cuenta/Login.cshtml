
@{
    ViewBag.Title = "Login";
}





<main class="container mt-5">
    <div class="row">

        <!-- Columna izquierda con la imagen del comercio -->
        <section class="col-md-6 d-flex align-items-center justify-content-center">
            <img src="../Content/Images/logo_anirok.png" alt="Anirok logo" class="img-fluid">
        </section>

        <!-- Columna derecha con el formulario de inicio de sesión -->
        <section class="col-md-6 mx-auto d-flex flex-column align-items-center justify-content-center">

            <h2 class="title-font">Login</h2>

            @if (Session["UsuarioId"] == null)
            {
                <div class="alert alert-danger">
                    Estás deslogueado. Para realizar tu pedido o ver tu carrito, por favor inicia sesión.
                </div>
            }



            <!-- Mostrar mensajes de éxito o error -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["LoginSuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["LoginSuccessMessage"]
                </div>
            }


            <form method="post" action="@Url.Action("Login", "Cuenta")">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="usuarioOEmail" class="form-label">Usuario o email:</label>
                    <input type="text" class="form-control custom-input-width" id="usuarioOEmail" name="usuarioOEmail" required>
                </div>
                <div class="mb-3">
                    <label for="contrasena" class="form-label">Contraseña:</label>
                    <input type="password" class="form-control custom-input-width" id="contrasena" name="contrasena" required>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Iniciar sesión</button>
                </div>
            </form>
            <p class="mt-3">¿No tenés cuenta? <a href="@Url.Action("Registro", "Cuenta")">Registrate</a>.</p>
        </section>
    </div>
</main>
