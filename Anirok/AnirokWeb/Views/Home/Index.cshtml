@model List<AnirokWeb.Models.Producto>

@{
    ViewBag.Title = "Home Page";
}


@if (TempData["LoginSuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["LoginSuccessMessage"]
    </div>
}



<main>
    <!-- Carrusel (Carousel) para pantallas grandes -->
    <div id="carouselExample" class="carousel slide hero-carousel d-none d-md-block" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">

                <img src="~/Content/Images/slide4.jpg" class="d-block w-100" alt="Manga y cultura pop">
            </div>
            <div class="carousel-item">
                <!-- Puedes agregar más elementos con GIFs -->
                <img src="~/Content/Images/slide5.jpg" class="d-block w-100" alt="Productos Anirok">
            </div>
            <!-- Agrega más elementos según sea necesario -->
        </div>
        <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

    <section class="section-heading" aria-labelledby="productos-recomendados">
        <span class="section-heading__eyebrow">Catálogo Anirok</span>
        <h1 id="productos-recomendados">Productos recomendados</h1>
        <p>Stock actualizado y compra directa desde la tienda.</p>
    </section>


    <section class="mb-4">
        <!-- Filas con tarjetas -->
        <section class="mb-4">
            <!-- Filas con tarjetas -->
            <div class="row">
                @if (Model == null || !Model.Any())
                {
                    <p>No hay productos disponibles en esta categoría.</p>
                }
                else
                {
                    foreach (var producto in Model)
                    {
                        <div class="col-12 col-sm-6 col-lg-3 mb-4">
                            @Html.Partial("_ProductoCard", producto)
                        </div>
                    }
                }
            </div>
        </section>


    </section>
</main>
