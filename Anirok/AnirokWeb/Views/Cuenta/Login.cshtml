
@{
    ViewBag.Title = "Login";
}





<main class="login-page">
    <section class="login-card">
        <img src="@Url.Content("~/Content/Images/logo_anirok.png")" alt="Anirok logo" class="login-card-logo">
        <p class="login-form-kicker">Bienvenido de nuevo</p>
        <h1>Iniciar sesión</h1>
        <p class="login-card-copy">Ingresá para guardar tu carrito y comprar de forma segura.</p>

            <!-- Mostrar mensajes de éxito o error -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["LoginSuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["LoginSuccessMessage"]
                </div>
            }


            <form method="post" action="@Url.Action("Login", "Cuenta")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label for="usuarioOEmail" class="form-label">Usuario o email:</label>
                    <input type="text" class="form-control custom-input-width" id="usuarioOEmail" name="usuarioOEmail" required>
                </div>
                <div class="mb-3">
                    <label for="contrasena" class="form-label">Contraseña:</label>
                    <input type="password" class="form-control custom-input-width" id="contrasena" name="contrasena" required>
                </div>
                <div class="text-center">
                    <button type="submit" class="login-submit">Iniciar sesión</button>
                </div>
            </form>
            <p class="mt-3">¿No tenés cuenta? <a href="@Url.Action("Registro", "Cuenta")">Registrate</a>.</p>
    </section>
</main>
